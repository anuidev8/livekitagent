LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=huella-guide

# Voice backend: nova (Amazon Nova Sonic 2) | cartesia (Inference STT/LLM + Cartesia TTS)
VOICE_BACKEND=nova

# Renew only the internal Nova Sonic stream after 7 minutes. The LiveKit room
# and participant remain connected; valid range is 60-420 (AWS hard limit: 480).
NOVA_SESSION_REFRESH_SECONDS=420

# Set to off|false to disable LiveKit Cloud OTLP telemetry export during local dev
LIVEKIT_TELEMETRY=off

# Amazon Nova Sonic 2 (Bedrock realtime) — only voice backend
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Spanish voices: lupe (feminine) | carlos (masculine)
NOVA_VOICE=lupe
# HIGH | MEDIUM | LOW
NOVA_TURN_DETECTION=MEDIUM

# Cartesia (only when VOICE_BACKEND=cartesia)
# Create at: https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Voice Library → your voice → copy the UUID (not the display name)
CARTESIA_VOICE=
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi
LLM_MODEL=google/gemma-4-31b-it
TTS_MODEL=sonic-3
TTS_LANGUAGE=es
# float 0.6–1.5, or slow | normal | fast
TTS_SPEED=1.0

# Seconds to wait for the browser kiosk before on_enter RPC (Cartesia path)
PARTICIPANT_WAIT_SECONDS=12
