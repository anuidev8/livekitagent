LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=huella-guide

# Renew only the internal Nova Sonic stream after 6 minutes. The LiveKit room
# and participant remain connected; valid range is 60-420 (AWS hard limit: 480).
NOVA_SESSION_REFRESH_SECONDS=360

# Amazon Nova Sonic 2 (Bedrock realtime) — only voice backend
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Spanish voices: lupe (feminine) | carlos (masculine)
NOVA_VOICE=lupe
# HIGH | MEDIUM | LOW
NOVA_TURN_DETECTION=MEDIUM
