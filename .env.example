LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=huella-guide

# Amazon Nova Sonic 2 (Bedrock realtime) — only voice backend
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Spanish voices: lupe (feminine) | carlos (masculine)
NOVA_VOICE=lupe
# HIGH | MEDIUM | LOW
NOVA_TURN_DETECTION=MEDIUM
# Bedrock bidirectional streams have a hard ~8min (480s) cap; the plugin
# recycles the session before that to avoid a forced disconnect. Default is
# 360s, which a typical full kiosk journey (~6min) can reach mid-conversation.
# 420s leaves a 60s safety buffer under the real AWS limit while covering a
# normal-paced visit without recycling.
LK_SESSION_MAX_DURATION=420
