<?xml version="1.0" encoding="UTF-8"?>
<!--
  Amazon Polly pronunciation lexicon — SETI Huella Digital (Spanish).
  Console upload:
    Name: SetiHuella
    File: SetiHuella.pls
  xml:lang must match the Polly voice language (es-US for Lupe, Pedro, etc.).
  Graphemes are case-sensitive: include common casings below.
-->
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
      alphabet="ipa"
      xml:lang="es-US">

  <!-- Brand / product -->
